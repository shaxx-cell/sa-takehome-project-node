<main>
  <div class="mt-40 text-center text-success">
    <h1 id="status-heading">
      <i class="far fa-check-circle"></i> 
      Payment Successful!
    </h1>
  </div>
  <div class="mt-40 text-center">
    <div class="mt-40">
    <h4>Payment Details</h4>
    <p><strong>PaymentIntent ID:</strong> <span id="pi-id">Loading...</span></p>
    <p><strong>Amount Charged:</strong> $<span id="pi-amount">Loading...</span></p>
  </div>
  </div>
</main>

<script>
  // initialize Stripe
  const stripe = Stripe('{{publishable_key}}');

  //Get the URL parameters
  const urlParams = new URLSearchParams(window.location.search);
  const clientSecret = urlParams.get('payment_intent_client_secret');

  //retrieve the paymentIntent using client secret 
  if (clientSecret) {
    stripe.retrievePaymentIntent(clientSecret).then(({ paymentIntent }) => {
      
      //populate the HTML with ID and Amount
      document.querySelector('#pi-id').textContent = paymentIntent.id;


      //Success: money moved
      if (paymentIntent.status === 'succeeded'){
      document.querySelector('#pi-amount').textContent = (paymentIntent.amount / 100).toFixed(2);
    }
  
      //Processing: The payment is pending 
    else if (paymentIntent.status === 'processing'){
      document.querySelector('#pi-amount').textContent = "Processing...";
      document.querySelector('#status-heading').textContent = "Payment Processing...";
    }
      //Failed:
      else {
    document.querySelector('#pi-amount').textContent = "0.00";
    document.querySelector('#status-heading').textContent = "Payment Failed";

  }
     }); 
     //no payment details 
  } else { 
    document.querySelector('#pi-id').textContent = "Missing payment details";
  } 
  </script>
